load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "crawler",
    srcs = ["crawler.go"],
    importpath = "ai-daily-brief/internal/crawler",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/database",
        "@com_github_mmcdole_gofeed//:gofeed",
        "@com_github_puerkitobio_goquery//:goquery",
        "@io_gorm_gorm//:gorm",
    ],
)

go_test(
    name = "crawler_test",
    srcs = ["crawler_test.go"],
    embed = [":crawler"],
    deps = [
        "//internal/database",
    ],
)
