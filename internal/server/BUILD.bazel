load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "server",
    srcs = ["server.go"],
    importpath = "ai-daily-brief/internal/server",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/agent",
        "//internal/config",
        "//internal/crawler",
        "//internal/database",
        "//internal/mailer",
        "//internal/security",
        "@com_github_gin_gonic_gin//:gin",
        "@com_github_robfig_cron_v3//:cron",
        "@io_gorm_gorm//:gorm",
    ],
)

go_test(
    name = "server_test",
    srcs = ["server_test.go"],
    embed = [":server"],
    deps = [
        "//internal/database",
        "@com_github_gin_gonic_gin//:gin",
        "@com_github_glebarez_sqlite//:sqlite",
        "@io_gorm_gorm//:gorm",
        "@io_gorm_gorm//logger",
    ],
)
