load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_pkg//pkg:deb.bzl", "pkg_deb")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_pkg//pkg:zip.bzl", "pkg_zip")

go_library(
    name = "ai-daily-brief_lib",
    srcs = ["main.go"],
    embedsrcs = ["dist/placeholder.txt"],
    importpath = "ai-daily-brief/cmd/ai-daily-brief",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/config",
        "//internal/crawler",
        "//internal/database",
        "//internal/server",
    ],
)

go_binary(
    name = "ai-daily-brief",
    embed = [":ai-daily-brief_lib"],
    visibility = ["//visibility:public"],
)

# Cross-platform build targets
go_binary(
    name = "ai_daily_brief_darwin_arm64",
    embed = [":ai-daily-brief_lib"],
    goarch = "arm64",
    goos = "darwin",
    visibility = ["//visibility:public"],
)

go_binary(
    name = "ai_daily_brief_darwin_amd64",
    embed = [":ai-daily-brief_lib"],
    goarch = "amd64",
    goos = "darwin",
    visibility = ["//visibility:public"],
)

go_binary(
    name = "ai_daily_brief_linux_amd64",
    embed = [":ai-daily-brief_lib"],
    goarch = "amd64",
    goos = "linux",
    visibility = ["//visibility:public"],
)

go_binary(
    name = "ai_daily_brief_windows_amd64",
    embed = [":ai-daily-brief_lib"],
    goarch = "amd64",
    goos = "windows",
    visibility = ["//visibility:public"],
)

# Standalone distribution archives (containing both compiled binaries and default config file)
pkg_tar(
    name = "pkg_darwin_arm64",
    srcs = [
        ":ai_daily_brief_darwin_arm64",
        "//:.env.toml",
        "//:LICENSE",
        "//:NOTICE",
        "//:README.md",
    ],
    out = "ai-daily-brief-darwin-arm64.tar.gz",
    extension = "tar.gz",
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "pkg_darwin_amd64",
    srcs = [
        ":ai_daily_brief_darwin_amd64",
        "//:.env.toml",
        "//:LICENSE",
        "//:NOTICE",
        "//:README.md",
    ],
    out = "ai-daily-brief-darwin-amd64.tar.gz",
    extension = "tar.gz",
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "pkg_linux_amd64",
    srcs = [
        ":ai_daily_brief_linux_amd64",
        "//:.env.toml",
        "//:LICENSE",
        "//:NOTICE",
        "//:README.md",
    ],
    out = "ai-daily-brief-linux-amd64.tar.gz",
    extension = "tar.gz",
    visibility = ["//visibility:public"],
)

pkg_zip(
    name = "pkg_windows_amd64",
    srcs = [
        ":ai_daily_brief_windows_amd64",
        "//:.env.toml",
        "//:LICENSE",
        "//:NOTICE",
        "//:README.md",
    ],
    out = "ai-daily-brief-windows-amd64.zip",
    visibility = ["//visibility:public"],
)

# Debian / Chromebook Installer Packaging Targets
pkg_files(
    name = "deb_binary",
    srcs = [":ai_daily_brief_linux_amd64"],
    attributes = pkg_attributes(
        mode = "0755",
    ),
    prefix = "usr/bin",
    renames = {
        ":ai_daily_brief_linux_amd64": "ai-daily-brief",
    },
)

pkg_files(
    name = "deb_config",
    srcs = ["//:.env.toml"],
    attributes = pkg_attributes(
        mode = "0644",
    ),
    prefix = "etc/ai-daily-brief",
    renames = {
        "//:.env.toml": "env.toml",
    },
)

pkg_files(
    name = "deb_desktop",
    srcs = ["//:build/linux/ai-daily-brief.desktop"],
    prefix = "usr/share/applications",
)

pkg_tar(
    name = "deb_data",
    srcs = [
        ":deb_binary",
        ":deb_config",
        ":deb_desktop",
    ],
)

pkg_deb(
    name = "pkg_deb",
    data = ":deb_data",
    description = "AI & Cloud Intelligence Agent dashboard and executive newsletter",
    maintainer = "AI Daily Brief Developer <ai.newsletter.agent@gmail.com>",
    package = "ai-daily-brief",
    version = "1.0.0",
    visibility = ["//visibility:public"],
)
