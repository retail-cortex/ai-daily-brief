load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

go_library(
    name = "mcp-server_lib",
    srcs = ["main.go"],
    importpath = "ai-daily-brief/cmd/mcp-server",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/config",
        "//internal/database",
        "//internal/mcp",
    ],
)

go_binary(
    name = "mcp-server",
    embed = [":mcp-server_lib"],
    visibility = ["//visibility:public"],
)

# Cloud Run Container Cross-Platform Targets
go_binary(
    name = "mcp_server_linux_amd64",
    embed = [":mcp-server_lib"],
    goarch = "amd64",
    goos = "linux",
    pure = "on",
    visibility = ["//visibility:public"],
)

go_binary(
    name = "mcp_server_linux_arm64",
    embed = [":mcp-server_lib"],
    goarch = "arm64",
    goos = "linux",
    pure = "on",
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "pkg_mcp_linux_amd64",
    srcs = [
        ":mcp_server_linux_amd64",
        "//:.env.toml",
        "//:LICENSE",
        "//:NOTICE",
        "//:README.md",
    ],
    out = "ai-daily-brief-mcp-linux-amd64.tar.gz",
    extension = "tar.gz",
    visibility = ["//visibility:public"],
)
