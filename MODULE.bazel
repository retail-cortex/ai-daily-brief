module(
    name = "ai_news_agent",
    version = "0.0.0",
)

# rules_go & Gazelle Configuration
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.53.0")
bazel_dep(name = "rules_pkg", version = "1.0.1")

# Register Go Toolchain
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.3")

# Load Go dependencies from go.mod
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
go_deps.gazelle_override(
    path = "github.com/rrmcguinness/modenv",
    build_file_generation = "clean",
)
# No module_override needed for v0.0.1

# Expose Go repositories
use_repo(
    go_deps,
    "com_github_gin_gonic_gin",
    "com_github_glebarez_sqlite",
    "com_github_gorilla_websocket",
    "com_github_mmcdole_gofeed",
    "com_github_puerkitobio_goquery",
    "com_github_robfig_cron_v3",
    "com_github_rrmcguinness_modenv",
    "io_gorm_gorm",
    "org_golang_x_oauth2",
)

# Node / NPM / pnpm Configuration via rules_js
bazel_dep(name = "rules_nodejs", version = "6.3.0")
bazel_dep(name = "aspect_rules_js", version = "3.4.0")

# Node toolchain setup
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.12.0")
use_repo(node, "nodejs_toolchains")

# Translate Node package-lock.json automatically
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//web:pnpm-lock.yaml",
    lifecycle_hooks_exclude = ["better-sqlite3"],
)
use_repo(npm, "npm")
