module(
    name = "ai_daily_brief",
    version = "0.0.0",
)

# rules_go & Gazelle Configuration
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.53.0")
bazel_dep(name = "rules_pkg", version = "1.0.1")

# Register Go Toolchain
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.3")

# Load Go dependencies from go.mod
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
go_deps.gazelle_override(
    build_file_generation = "clean",
    path = "github.com/rrmcguinness/modenv",
)
# No module_override needed for v0.0.1

# Expose Go repositories
use_repo(
    go_deps,
    "com_github_gin_gonic_gin",
    "com_github_glebarez_sqlite",
    "com_github_gorilla_websocket",
    "com_github_mmcdole_gofeed",
    "com_github_puerkitobio_goquery",
    "com_github_robfig_cron_v3",
    "com_github_rrmcguinness_modenv",
    "com_google_cloud_go_compute_metadata",
    "com_google_cloud_go_secretmanager",
    "io_gorm_driver_postgres",
    "io_gorm_gorm",
    "org_golang_x_oauth2",
)

# rules_hugo Documentation Engine
bazel_dep(name = "rules_hugo", version = "0.3.0")
git_override(
    module_name = "rules_hugo",
    commit = "4710c8855aee048aa98f6b6be57723ae83084fcc",
    remote = "https://github.com/retail-cortex/rules-hugo.git",
)

bazel_dep(name = "rules_shell", version = "0.6.1")

hugo_deps = use_extension("@rules_hugo//hugo:extensions.bzl", "hugo_deps")
use_repo(hugo_deps, "hugo", "hugo_theme_book")
bazel_dep(name = "rules_multirun", version = "0.11.0")
