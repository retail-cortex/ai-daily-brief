load("@rules_hugo//hugo:rules.bzl", "hugo_serve", "hugo_site", "hugo_theme")

hugo_theme(
    name = "book",
    srcs = [
        "@hugo_theme_book//:files",
    ],
)

hugo_site(
    name = "docs",
    config = "hugo.toml",
    content = glob(["content/**"]),
    theme = ":book",
    visibility = ["//visibility:public"],
)

hugo_serve(
    name = "serve",
    dep = [":docs"],
    visibility = ["//visibility:public"],
)
