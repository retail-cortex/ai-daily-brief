# Ignore local files, binaries, secrets, and environment overrides
.git
.gitignore
.bazelrc*
bazel-*
data/
*.db
*.db-journal
*.db-wal
.env
.env.*
*.local.toml
.env.local.toml
**/.*.local.toml
deployments/**/terraform/.terraform*
deployments/**/terraform/*.tfstate*
deployments/**/terraform/*.tfvars
deployments/terraform/.terraform*
deployments/terraform/*.tfstate*
deployments/terraform/*.tfvars
*.key
*.pem
*.p12
*.crt
.venv
**/.venv
__pycache__
**/__pycache__
apps/
